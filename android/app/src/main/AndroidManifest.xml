<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════════════════════════════════════════════════════════
         v83 (round-96): Google Play device-availability fixes.
         Play flagged two implied-REQUIRED features that block install
         on desktops / Android XR / wifi-less POS terminals:
           • android.hardware.screen.portrait — implied by
             ScannerActivity's locked orientation.
           • android.hardware.wifi — implied by the ACCESS_WIFI_STATE
             permission that @react-native-community/netinfo merges in.
         Every hardware feature below is genuinely OPTIONAL for this
         app: the POS is 100% offline, the thermal printer is an
         accessory, the scanner keeps its portrait lock on phones
         (devices without portrait simply keep the natural
         orientation), and the app-lock falls back to the merchant
         PIN when no fingerprint reader exists (BiometricModule
         reports "unavailable" → PIN path).
         ══════════════════════════════════════════════════════════════ -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- ══════════════════════════════════════════════════════════════
         On-Device Vision (Camera + TFLite) — 100% offline processing
         ══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- License activation / periodic verification — the ONLY online
         feature; the POS itself keeps working fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v83 (round-96): netinfo merges ACCESS_WIFI_STATE, which (a)
         implied a REQUIRED wifi feature on Google Play and (b) surfaces
         "Wi-Fi connection information" in the store listing — wrong
         optics for a fully-offline POS. The app only reads
         connectivity (isConnected / isInternetReachable via
         ConnectivityManager — ACCESS_NETWORK_STATE above), never wifi
         details; netinfo guards every WifiManager call behind
         isAccessWifiStatePermissionGranted, so stripping the
         permission is 100% crash-safe. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <!-- Local stock-alert notifications (runtime on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v13 (round-19 #2): app-lock fingerprint prompt (normal
         permission — granted at install, no runtime request). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ══════════════════════════════════════════════════════════════
         Thermal Printer — Bluetooth Classic SPP (ESC/POS)
         ══════════════════════════════════════════════════════════════ -->
    <!-- Legacy (Android 11 and below): connect / pair -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Runtime (Android 12+): neverForLocation flag avoids the location
         permission requirement for printer discovery. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Legacy Bluetooth scanning (Android 5–11) needs coarse location. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- ══════════════════════════════════════════════════════════════
         Local report export (CSV / XLS to Downloads)
         ══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:usesCleartextTraffic="true"
      android:supportsRtl="true"
      android:enableOnBackInvokedCallback="false"
      android:theme="@style/AppTheme">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/SelaSplash"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- ════════════════════════════════════════════════════════
           v8 scanner engines — a NATIVE full-screen window that
           lives entirely outside the React Native view tree (the
           definitive fix for the blind/black camera: the preview is
           laid out by Android itself, always fills the screen, and
           the torch is a real native toggle).
           ════════════════════════════════════════════════════════ -->
      <activity
        android:name=".native_modules.ScannerActivity"
        android:label="سيلا — الماسح"
        android:screenOrientation="portrait"
        android:exported="false"
        android:theme="@style/AppTheme" />

      <!-- v25 (round-32 #3): share/print the PDF statements from the
           Downloads/SmartVisionPOS folder on Android 9 and older. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
